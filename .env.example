# Verbindung zur MariaDB/MySQL. Nur Session-Metadaten werden hier gespeichert,
# keine personenbezogenen Teilnehmerdaten (siehe docs/BACKLOG.md, Prinzip P1).
#
# Format: mysql://<user>:<password>@<host>:<port>/<database>
# Sonderzeichen im Passwort MÜSSEN URL-encodet werden (z.B. ^ -> %5E, ? -> %3F),
# sonst schlägt das URL-Parsing in src/lib/prisma.ts fehl.
#
# Lokal:      host = localhost
# Im Docker-Container (Bridge): host = host.docker.internal (siehe docs/DEPLOYMENT.md)
DATABASE_URL="mysql://user:password@localhost:3306/smart-student-picker"
